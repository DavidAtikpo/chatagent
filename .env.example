# Copier vers .env.local

# Neon PostgreSQL (pooler OK — le web retire -pooler et applique schema= via search_path)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&schema=Yayra
# ou : DATABASE_SCHEMA=Yayra

# Auth session (min 32 chars) — même valeur que AUTH_SECRET côté API Python
AUTH_SECRET=laclesecretedeyayra_apid

# Email reset (optionnel — sans clé, le lien s'affiche dans les logs serveur en dev)
RESEND_API_KEY=
EMAIL_FROM=Yayra <noreply@votredomaine.com>
# Réception des messages dashboard /dashboard/support (même Resend que ci-dessus)
SUPPORT_TEAM_EMAIL=support@votredomaine.com

# Cloudinary (logos, PDF, images liens trackés) — une seule ligne suffit :
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ou séparément : CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WIDGET_URL=/widget.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — montants 10 / 20 / 40 USD définis dans src/lib/billing-config.ts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optionnel (Stripe.js côté client si besoin plus tard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
